#!/usr/bin/env bash
#MISE description="Start a single runner host loop (one VM per job)"
# Thin wrapper: delegates all logic to host/runner.py.
# For N concurrent runners use `mise run runners:parallel`.

set -euo pipefail

ROOT="${MISE_PROJECT_ROOT:?run via 'mise run runners:start'}"
cd "$ROOT"
SRC_ENV="$ROOT/.env"
[ -f "$SRC_ENV" ] || { echo "missing $SRC_ENV" >&2; exit 1; }

# Keep the always-on Tart host runner separate from the shared mise tree. A
# self-hosted Actions job can run jdx/mise-action concurrently, which may
# refresh its shared shims while this process is cloning a VM. This task is
# also used outside launchd, so establish the same private mise environment
# here as runners:daemon:install does.
MISE_BIN="$(command -v mise || true)"
[ -x "$MISE_BIN" ] || MISE_BIN="$HOME/.local/bin/mise"
[ -x "$MISE_BIN" ] || { echo "could not find the mise binary" >&2; exit 1; }

export MISE_DATA_DIR="$HOME/.local/share/tartelette/mise"
export MISE_CACHE_DIR="$HOME/Library/Caches/tartelette/mise"
export MISE_STATE_DIR="$HOME/.local/state/tartelette/mise"
mkdir -p "$MISE_DATA_DIR" "$MISE_CACHE_DIR" "$MISE_STATE_DIR"

# Avoid an install on every loop, but bootstrap the private toolset on the
# first manual start (or after it was removed).
if ! "$MISE_BIN" --cd "$ROOT" exec -- tart --version >/dev/null 2>&1; then
  echo "[runners:start] installing Tart in the isolated mise environment"
  "$MISE_BIN" --cd "$ROOT" install
fi
export PATH="$MISE_DATA_DIR/shims:$PATH"

# Honor TART_HOME from .env so the pre-flight `tart list` reads the same store
# the image was built into. launchd does not inherit a shell TART_HOME export,
# so the daemon would otherwise look in the empty default ~/.tart.
TART_HOME_VAL="$(grep -E '^TART_HOME=' "$SRC_ENV" | head -1 | cut -d= -f2-)"
[ -n "$TART_HOME_VAL" ] && export TART_HOME="$TART_HOME_VAL"

# Local-only flow: fail fast if the image is not in tart list.
REGISTRY_URL="$(grep -E '^REGISTRY_URL=' "$SRC_ENV" | head -1 | cut -d= -f2-)"
IMAGE="$(grep -E '^REGISTRY_IMAGE_NAME=' "$SRC_ENV" | head -1 | cut -d= -f2-)"
if [ -z "$REGISTRY_URL" ] && ! tart list --format json | jq -e --arg n "$IMAGE" '.[] | select(.Name==$n)' >/dev/null; then
  echo "image '$IMAGE' (REGISTRY_IMAGE_NAME in .env) not found in tart list." >&2
  echo "build it with 'mise run vm:build' or fix REGISTRY_IMAGE_NAME. Available:" >&2
  tart list --format json | jq -r '.[] | select(.Source=="local" and (.Name|startswith("ios-app-ci"))) | "  "+.Name' >&2
  exit 1
fi

exec python "$ROOT/host/runner.py" --env "$SRC_ENV" --log "$ROOT/runner.log"
