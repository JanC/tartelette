#!/usr/bin/env bash
#MISE description="Deregister GitHub Actions runners by configured name prefix"
# Matches runners whose name starts with RUNNER_NAME from .env, or this Mac's
# derived default name when RUNNER_NAME is empty. Useful after killing
# runners:parallel leaves orphans registered in GitHub.
#
# Usage: mise run runners:clean [-y|--yes] [--offline-only]
#   -y/--yes skips the confirmation prompt, for unattended use (launchd, cron).
#   Without it and without a TTY to prompt on, this exits non-zero rather than
#   deleting anything.
# Requires: jq, plus either
#   GITHUB_AUTH_METHOD=token: GITHUB_API_TOKEN
#   GITHUB_AUTH_METHOD=app:   GITHUB_APP_ID + GITHUB_APP_PRIVATE_KEY_PATH
#                             + GITHUB_OWNER (+ GITHUB_REPO for repo scope)

set -euo pipefail

ROOT="${MISE_PROJECT_ROOT:?run via 'mise run runners:clean'}"
SRC_ENV="$ROOT/.env"
[ -f "$SRC_ENV" ] || { echo "missing $SRC_ENV" >&2; exit 1; }

set -a; . "$SRC_ENV"; set +a

# Remove drain sentinel so runners resume after clean.
rm -f "$ROOT/.runners/drain"

# Keep this in sync with Config.from_env: an empty (or missing) RUNNER_NAME
# uses the sanitized macOS Computer Name with a "-vm" suffix.
RUNNER_NAME="${RUNNER_NAME:-}"
if [ -z "$RUNNER_NAME" ]; then
  RUNNER_NAME="$(PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" python -c \
    'from host.runner import default_runner_name; print(default_runner_name())')"
fi

if [ "${GITHUB_AUTH_METHOD:-token}" = "app" ]; then
  : "${GITHUB_OWNER:?GITHUB_OWNER unset}"
  if [ -n "${GITHUB_REPO:-}" ]; then
    RUNNERS_URL="https://api.github.com/repos/${GITHUB_OWNER}/${GITHUB_REPO}/actions/runners"
  else
    RUNNERS_URL="https://api.github.com/orgs/${GITHUB_OWNER}/actions/runners"
  fi
  TOKEN=$(python "$ROOT/host/gh_token.py" --kind installation --env "$SRC_ENV")
else
  : "${GITHUB_API_TOKEN:?GITHUB_API_TOKEN unset}"
  : "${GITHUB_OWNER:?GITHUB_OWNER unset}"
  TOKEN="$GITHUB_API_TOKEN"
  if [ -n "${GITHUB_REPO:-}" ]; then
    RUNNERS_URL="https://api.github.com/repos/${GITHUB_OWNER}/${GITHUB_REPO}/actions/runners"
  else
    RUNNERS_URL="https://api.github.com/orgs/${GITHUB_OWNER}/actions/runners"
  fi
fi

ASSUME_YES=0
OFFLINE_ONLY=0
for arg in "$@"; do
  case "$arg" in
    -y|--yes) ASSUME_YES=1 ;;
    --offline-only) OFFLINE_ONLY=1 ;;
    -*) echo "unknown flag: $arg" >&2; exit 1 ;;
    *) echo "unexpected argument: $arg" >&2; exit 1 ;;
  esac
done

list_json=$(curl -fsS -H "Authorization: bearer $TOKEN" "$RUNNERS_URL")

filter='.runners[] | select(.name | startswith($p))'
[ $OFFLINE_ONLY -eq 1 ] && filter="$filter | select(.status==\"offline\")"

targets=()
while IFS= read -r line; do
  targets+=("$line")
done < <(echo "$list_json" | jq -r --arg p "$RUNNER_NAME" "$filter | \"\\(.id) \\(.name) \\(.status)\"")

if [ ${#targets[@]} -eq 0 ]; then
  echo "no runners matching prefix '$RUNNER_NAME'$([ $OFFLINE_ONLY -eq 1 ] && echo ' (offline)')"
  exit 0
fi

printf '%s\n' "${targets[@]}"
if [ "$ASSUME_YES" -ne 1 ]; then
  # Under launchd/cron there is no stdin to prompt on: `read` hits EOF, returns
  # non-zero, and `set -e` aborts the task before the delete loop -- so an
  # unattended sweep silently never clears a stale registration. Say so.
  if [ ! -t 0 ]; then
    echo "no TTY to confirm on; re-run with -y to delete unattended" >&2
    exit 1
  fi
  read -r -p "delete the above ${#targets[@]} runner(s)? [y/N] " ans
  [ "$ans" = "y" ] || [ "$ans" = "Y" ] || { echo "aborted"; exit 0; }
fi

for line in "${targets[@]}"; do
  id="${line%% *}"
  curl -fsS -X DELETE -H "Authorization: bearer $TOKEN" \
    "$RUNNERS_URL/$id" && echo "deleted $line"
done
