#!/usr/bin/env bash
#MISE description="Stop and remove the runners LaunchAgent"
# Boots out the LaunchAgent installed by runners:daemon:install and deletes its
# plist. SIGTERM from launchd propagates to runners:parallel, which deletes the
# in-flight VMs via its own trap before exiting.

set -euo pipefail

LABEL="dev.tartelette.runners"
SERVICE="gui/$(id -u)/$LABEL"
PLIST_DST="$HOME/Library/LaunchAgents/$LABEL.plist"
LEGACY_DAEMON="/Library/LaunchDaemons/$LABEL.plist"

# Clean up any legacy system LaunchDaemon from an older install.
if [ -f "$LEGACY_DAEMON" ]; then
  echo "[daemon:uninstall] removing legacy system LaunchDaemon (sudo required)"
  sudo launchctl bootout system "$LEGACY_DAEMON" 2>/dev/null || true
  sudo rm -f "$LEGACY_DAEMON"
fi

if [ ! -f "$PLIST_DST" ]; then
  echo "[daemon:uninstall] $PLIST_DST not present; nothing to do"
  exit 0
fi

echo "[daemon:uninstall] booting out $LABEL"
launchctl bootout "$SERVICE" 2>/dev/null || true
rm -f "$PLIST_DST"
echo "[daemon:uninstall] removed $PLIST_DST"
