#!/usr/bin/env bash
#MISE description="Stop and remove the runners LaunchDaemon"
# Boots out the LaunchDaemon installed by runners:daemon:install and deletes its
# plist. SIGTERM from launchd propagates to runners:parallel, which deletes the
# in-flight VMs via its own trap before exiting.

set -euo pipefail

LABEL="com.atlas.tart-ci.runners"
PLIST_DST="/Library/LaunchDaemons/$LABEL.plist"

if [ ! -f "$PLIST_DST" ]; then
  echo "[daemon:uninstall] $PLIST_DST not present; nothing to do"
  exit 0
fi

echo "[daemon:uninstall] booting out $LABEL (sudo required)"
sudo launchctl bootout system "$PLIST_DST" 2>/dev/null || true
sudo rm -f "$PLIST_DST"
echo "[daemon:uninstall] removed $PLIST_DST"
