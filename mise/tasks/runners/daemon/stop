#!/usr/bin/env bash
#MISE description="Stop the runners LaunchDaemon without removing it"
# Unloads the daemon now and marks it disabled so KeepAlive/boot won't respawn
# it. The plist stays installed; resume with runners:daemon:start. SIGTERM from
# bootout propagates to runners:parallel, which deletes in-flight VMs via its trap.

set -euo pipefail

LABEL="com.atlas.tart-ci.runners"
PLIST_DST="/Library/LaunchDaemons/$LABEL.plist"

if [ ! -f "$PLIST_DST" ]; then
  echo "[daemon:stop] not installed ($PLIST_DST absent); nothing to do"
  exit 0
fi

echo "[daemon:stop] booting out + disabling $LABEL (sudo required)"
sudo launchctl bootout "system/$LABEL" 2>/dev/null || true
sudo launchctl disable "system/$LABEL"
echo "[daemon:stop] stopped (plist kept; resume with: mise run runners:daemon:start)"
