#!/usr/bin/env bash
#MISE description="Install a LaunchDaemon that runs runners:parallel at boot"
#USAGE arg "[n]" help="number of concurrent host loops (default 2; macOS caps macOS VMs at 2)" default="2"
# Renders a LaunchDaemon plist from live values (mise binary, repo root, user)
# and loads it so the host starts its ekiden runner loops automatically at boot
# (and restarts them if the supervisor dies). Mirrors vendor/ekiden's plist but
# drives `mise run runners:parallel` instead of launch.sh directly.
#
# The daemon runs as the current user, so enable auto-login on the host: macOS
# guests need an active user session (see vendor/ekiden/host/README.md).
#
# Stop/remove with `mise run runners:daemon:uninstall`.

set -euo pipefail

LABEL="com.atlas.tart-ci.runners"
PLIST_DST="/Library/LaunchDaemons/$LABEL.plist"

ROOT="${MISE_PROJECT_ROOT:?run via 'mise run runners:daemon:install'}"
USER_NAME="$(id -un)"

N="${usage_n:-2}"
case "$N" in
  ''|*[!0-9]*) echo "N must be a positive integer (got: $N)" >&2; exit 1 ;;
esac
[ "$N" -ge 1 ] || { echo "N must be >= 1" >&2; exit 1; }

# Inside a mise task `mise` is a real binary on PATH (not the shell function),
# but resolve defensively so the plist gets an absolute path launchd can exec.
MISE_BIN="$(command -v mise || true)"
[ -x "$MISE_BIN" ] || MISE_BIN="$HOME/.local/bin/mise"
[ -x "$MISE_BIN" ] || { echo "could not find the mise binary" >&2; exit 1; }

# launchd starts with a bare environment; hand it a PATH that covers Homebrew
# (tart, jq, sshpass) and mise's own shims.
BREW_PREFIX="$(/opt/homebrew/bin/brew --prefix 2>/dev/null || echo /opt/homebrew)"
DAEMON_PATH="$BREW_PREFIX/bin:$BREW_PREFIX/sbin:$HOME/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

TMP_PLIST="$(mktemp -t "$LABEL").plist"
cat > "$TMP_PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>$LABEL</string>
    <key>ProgramArguments</key>
    <array>
      <string>$MISE_BIN</string>
      <string>run</string>
      <string>runners:parallel</string>
      <string>$N</string>
    </array>
    <key>WorkingDirectory</key>
    <string>$ROOT</string>
    <key>EnvironmentVariables</key>
    <dict>
      <key>PATH</key>
      <string>$DAEMON_PATH</string>
      <key>HOME</key>
      <string>$HOME</string>
      <key>MISE_PROJECT_ROOT</key>
      <string>$ROOT</string>
    </dict>
    <key>UserName</key>
    <string>$USER_NAME</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>StandardOutPath</key>
    <string>$ROOT/daemon.log</string>
    <key>StandardErrorPath</key>
    <string>$ROOT/daemon.log</string>
  </dict>
</plist>
PLIST

echo "[daemon:install] rendered plist for user=$USER_NAME N=$N mise=$MISE_BIN"
echo "[daemon:install] installing $PLIST_DST (sudo required)"

sudo cp "$TMP_PLIST" "$PLIST_DST"
sudo chown root:wheel "$PLIST_DST"
sudo chmod 644 "$PLIST_DST"
rm -f "$TMP_PLIST"

# Replace any previous instance, then load. Enable first to clear any disabled
# state left by runners:daemon:stop, otherwise bootstrap loads it disabled.
sudo launchctl bootout system "$PLIST_DST" 2>/dev/null || true
sudo launchctl enable "system/$LABEL"
sudo launchctl bootstrap system "$PLIST_DST"

echo "[daemon:install] loaded $LABEL"
echo "[daemon:install] logs: $ROOT/daemon.log  (per-runner logs under .runners/runner-*/runner.log)"
echo "[daemon:install] status: sudo launchctl print system/$LABEL"
