#!/usr/bin/env bash
#MISE description="rsync a built guest image to another host or a local path (no registry)"
#USAGE arg "<dest>" help="ssh host (user@mac-mini) OR a local Tart store path (/Volumes/nvme/tart)"
#USAGE arg "<vm>" help="VM name from tart list, e.g. atlas-app-ci-26.3"
#USAGE flag "--dest-store <path>" help="remote Tart store root (ssh mode only; default: the remote's ~/.tart)"
#USAGE flag "-y --yes" help="skip the confirmation prompt"
# Copies the stopped VM's directory straight into the destination's Tart store.
# `tart clone` is store-local and push/pull need a registry, so a plain rsync is
# the simplest transport for a single consumer. Re-run after every rebuild.
#
# Dest is an ssh host OR a local path (one starting with / ~ or .), e.g. a mounted
# share. Local path = the Tart store root; the VM lands in <path>/vms/.
#
# Source store: local TART_HOME (from .env) else ~/.tart.
# Dest store (ssh): --dest-store if given, else the *remote's* ~/.tart (NOT the
#   local path — the remote's home/TART_HOME may differ).
#
# Usage: mise run vm:copy user@mac-mini atlas-app-ci-26.3
#        mise run vm:copy user@mac-mini atlas-app-ci-26.3 --dest-store /Volumes/nvme/tart
#        mise run vm:copy /Volumes/nvme/tart atlas-app-ci-26.3   # local path / mounted share
#
# Note: over an SMB mount the disk.img lands fully expanded (smbfs can't write
# sparse). For a compact copy use ssh mode with rsync 3.x on both ends.

set -euo pipefail

ROOT="${MISE_PROJECT_ROOT:?run via 'mise run vm:copy'}"
[ -f "$ROOT/.env" ] && { set -a; . "$ROOT/.env"; set +a; }

DEST="${usage_dest:?destination required}"
VM="${usage_vm:?VM name required}"
SRC_STORE="${TART_HOME:-$HOME/.tart}"
SRC="$SRC_STORE/vms/$VM"

[ -d "$SRC" ] || { echo "no such VM dir: $SRC (check 'tart list')" >&2; exit 1; }

# Refuse to copy a running VM — its disk would be inconsistent.
if tart list --format json | jq -e --arg n "$VM" '.[] | select(.Name==$n and .Running==true)' >/dev/null; then
  echo "$VM is running; stop it before copying" >&2
  exit 1
fi

# A dest starting with / ~ or . is a local path (the Tart store root); anything
# else is an ssh host.
case "$DEST" in
  /*|~*|.*) LOCAL=1 ;;
  *)        LOCAL=0 ;;
esac

# Human-readable dest for the summary (avoid an ssh round-trip before confirm).
if [ "$LOCAL" = 1 ]; then
  DEST_VMS="${DEST%/}/vms"
  TO="$DEST_VMS/"
elif [ -n "${usage_dest_store:-}" ]; then
  TO="$DEST:${usage_dest_store}/vms/"
else
  TO="$DEST:~/.tart/vms/ (resolved on remote)"
fi

SIZE="$(du -sh "$SRC" 2>/dev/null | cut -f1)"
cat <<SUMMARY
About to copy a guest image:
  VM:    $VM (${SIZE:-?} on disk)
  from:  $SRC
  to:    $TO
SUMMARY

if [ "${usage_yes:-}" != "true" ]; then
  read -r -p "proceed? [y/N] " ans
  [ "$ans" = "y" ] || [ "$ans" = "Y" ] || { echo "aborted"; exit 0; }
fi

# Resolve the dest /vms dir and create it. For ssh mode without --dest-store,
# resolve ~/.tart on the remote so it expands against the remote's $HOME.
if [ "$LOCAL" = 1 ]; then
  mkdir -p "$DEST_VMS"
  TARGET="$DEST_VMS/"
else
  if [ -n "${usage_dest_store:-}" ]; then
    DEST_VMS="${usage_dest_store}/vms"
  else
    DEST_VMS="$(ssh "$DEST" 'echo "${TART_HOME:-$HOME/.tart}/vms"')"
  fi
  ssh "$DEST" "mkdir -p '$DEST_VMS'"
  TARGET="$DEST:$DEST_VMS/"
fi

# Portable flags. macOS ships openrsync (since Sonoma), which lacks --info and
# --sparse; fall back accordingly. --compress keeps the disk's zero-holes cheap
# on the wire (no-op for a local/mounted copy). Note: without --sparse (openrsync,
# or any SMB mount) the dest disk.img is written fully expanded — for a compact
# dest, use ssh mode with rsync 3.x (brew install rsync) on both ends.
flags=(-a --compress)
if rsync --help 2>&1 | grep -q -- '--info'; then
  flags+=(--info=progress2)
elif rsync --help 2>&1 | grep -q -- '--progress'; then
  flags+=(--progress)
fi
rsync --help 2>&1 | grep -q -- '--sparse' && flags+=(--sparse)
rsync "${flags[@]}" "$SRC" "$TARGET"
echo "done. tart list should show $VM on the destination."
