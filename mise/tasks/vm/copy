#!/usr/bin/env bash
#MISE description="rsync a built guest image to another host (no registry)"
#USAGE arg "<dest>" help="ssh destination host, e.g. user@mac-mini"
#USAGE arg "<vm>" help="VM name from tart list, e.g. atlas-app-ci-26.3"
#USAGE flag "--dest-store <path>" help="remote Tart store root (default: the remote's ~/.tart)"
#USAGE flag "-y --yes" help="skip the confirmation prompt"
# Copies the stopped VM's directory straight into the destination's Tart store.
# `tart clone` is store-local and push/pull need a registry, so a plain rsync is
# the simplest transport for a single consumer. Re-run after every rebuild.
#
# Source store: local TART_HOME (from .env) else ~/.tart.
# Dest store:   --dest-store if given, else the *remote's* ~/.tart (NOT the local
#               path — the remote's home/TART_HOME may differ). If the remote uses
#               a custom TART_HOME, pass it via --dest-store.
#
# Usage: mise run vm:copy user@mac-mini atlas-app-ci-26.3
#        mise run vm:copy user@mac-mini atlas-app-ci-26.3 --dest-store /Volumes/nvme/tart

set -euo pipefail

ROOT="${MISE_PROJECT_ROOT:?run via 'mise run vm:copy'}"
[ -f "$ROOT/.env" ] && { set -a; . "$ROOT/.env"; set +a; }

DEST="${usage_dest:?destination host required}"
VM="${usage_vm:?VM name required}"
SRC_STORE="${TART_HOME:-$HOME/.tart}"
SRC="$SRC_STORE/vms/$VM"

[ -d "$SRC" ] || { echo "no such VM dir: $SRC (check 'tart list')" >&2; exit 1; }

# Refuse to copy a running VM — its disk would be inconsistent.
if tart list --format json | jq -e --arg n "$VM" '.[] | select(.Name==$n and .Running==true)' >/dev/null; then
  echo "$VM is running; stop it before copying" >&2
  exit 1
fi

# Human-readable dest for the summary (avoid an ssh round-trip before confirm):
# the real ~/.tart path is resolved on the remote only after the user agrees.
if [ -n "${usage_dest_store:-}" ]; then
  DEST_DISPLAY="${usage_dest_store}/vms"
else
  DEST_DISPLAY="~/.tart/vms (resolved on remote)"
fi

SIZE="$(du -sh "$SRC" 2>/dev/null | cut -f1)"
cat <<SUMMARY
About to copy a guest image:
  VM:    $VM (${SIZE:-?} on disk)
  from:  $SRC
  to:    $DEST:$DEST_DISPLAY
SUMMARY

if [ "${usage_yes:-}" != "true" ]; then
  read -r -p "proceed? [y/N] " ans
  [ "$ans" = "y" ] || [ "$ans" = "Y" ] || { echo "aborted"; exit 0; }
fi

# Resolve the remote store on the remote host so ~/.tart expands against the
# remote's $HOME, not ours. A custom --dest-store is used verbatim.
if [ -n "${usage_dest_store:-}" ]; then
  DEST_VMS="${usage_dest_store}/vms"
else
  DEST_VMS="$(ssh "$DEST" 'echo "${TART_HOME:-$HOME/.tart}/vms"')"
fi

ssh "$DEST" "mkdir -p '$DEST_VMS'"

# Portable flags. macOS ships openrsync (since Sonoma), which lacks --info and
# --sparse; fall back accordingly. --compress keeps the disk's zero-holes cheap
# on the wire. Note: without --sparse (openrsync) the dest disk.img is written
# fully expanded — for a compact dest, use rsync 3.x (brew install rsync).
flags=(-a --compress)
if rsync --help 2>&1 | grep -q -- '--info'; then
  flags+=(--info=progress2)
elif rsync --help 2>&1 | grep -q -- '--progress'; then
  flags+=(--progress)
fi
rsync --help 2>&1 | grep -q -- '--sparse' && flags+=(--sparse)
rsync "${flags[@]}" "$SRC" "$DEST:$DEST_VMS/"
echo "done. On $DEST: tart list should show $VM"
