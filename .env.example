# Copy to .env and fill the auth fields. Consumed by vendor/ekiden/host/launch.sh
# via xargs. CRITICAL: no quotes or apostrophes anywhere in this file (including
# comments) — xargs treats them as delimiters and the loader breaks with
# unterminated quote. Variable names are EKIDEN names; do not rename.

# Where Tart keeps its VM/image cache. Leave commented to use the default ~/.tart.
# Set this if TART_HOME is on an external disk (the host loop tart list / tart
# clone must see the same store the Packer build wrote to).
# TART_HOME=/Volumes/T9/tart

# Auth method for minting the runner registration token: token or app.
GITHUB_AUTH_METHOD=app

# --- app: GitHub App auth (GITHUB_AUTH_METHOD=app) ---
# Org-level runner: App installed on <ORG> with
#   Organization permissions -> Self-hosted runners: Read and write.
# For a repo-level runner instead: set GITHUB_REPO=<REPO> and grant
#   Repository permissions -> Administration: Read and write.
# Private key pem lives at the repo root (gitignored).
GITHUB_APP_ID=
# Must be absolute: the loop runs from .runners/runner-N under runners:parallel.
GITHUB_APP_PRIVATE_KEY_PATH=/absolute/path/to/app-private-key.pem
GITHUB_OWNER=<ORG>
GITHUB_REPO=

# --- token: PAT fallback (GITHUB_AUTH_METHOD=token) ---
# GITHUB_API_TOKEN=
# GITHUB_REGISTRATION_ENDPOINT=https://api.github.com/orgs/<ORG>/actions/runners/registration-token

# Where the runner attaches, and the labels it advertises.
# Must match runs-on in the workflow (self-hosted is added by GitHub automatically).
RUNNER_URL=https://github.com/<ORG>
RUNNER_LABELS=self-hosted,macos,arm64,tart
RUNNER_NAME=runner

# Image source for the host loop.
#   - Leave REGISTRY_URL empty to skip the registry and clone directly from the
#     locally-built Tart VM (single-host dev — see README Local-only flow).
#   - Set REGISTRY_URL=localhost:5001 (or a remote host) when distributing the
#     image via an OCI registry. REGISTRY_PATH becomes REGISTRY_URL/REGISTRY_IMAGE_NAME.
# REGISTRY_IMAGE_NAME must match a name shown by tart list. For local-only flow
# that is the bare VM name atlas-app-ci (no :latest — Packer does not tag).
# For the registry flow it is atlas-app-ci:latest.
REGISTRY_URL=
REGISTRY_IMAGE_NAME=macos-image-name

# SSH creds baked into the cirruslabs base image.
VM_USERNAME=admin
VM_PASSWORD=admin

# VM sizing (optional; ekiden defaults to 8192MB / 4 CPU).
VM_RAM=8192
VM_CPU=4

# Leave TRUNCATE_SIZE unset: the cirruslabs image is large enough and setting
# this triggers the disk-resize dance, which is not needed for MVP.
