# Copy to .env and fill GITHUB_API_TOKEN. Consumed by vendor/ekiden/host/launch.sh
# (it does `export $(xargs <.env)` every loop). These are EKIDEN's variable names —
# do not rename them, the unmodified submodule reads them verbatim.

# Fine-grained PAT with "Administration: Read & write" on JanC/tuist-app.
GITHUB_API_TOKEN=

# Repo-scoped ephemeral runner registration-token endpoint.
GITHUB_REGISTRATION_ENDPOINT=https://api.github.com/repos/JanC/tuist-app/actions/runners/registration-token

# Where the runner attaches, and the labels it advertises.
# Must match `runs-on:` in the workflow (self-hosted is added by GitHub automatically).
RUNNER_URL=https://github.com/JanC/tuist-app
RUNNER_LABELS=self-hosted,macos,arm64,tart
RUNNER_NAME=tuist-app-runner

# Local OCI registry image. REGISTRY_PATH becomes localhost:5000/atlas-app-ci:latest.
REGISTRY_URL=localhost:5000
REGISTRY_IMAGE_NAME=atlas-app-ci:latest

# SSH creds baked into the cirruslabs base image.
VM_USERNAME=admin
VM_PASSWORD=admin

# VM sizing (optional; ekiden defaults to 8192MB / 4 CPU).
VM_RAM=8192
VM_CPU=4

# Leave TRUNCATE_SIZE unset — the cirruslabs image is already large enough and
# setting it triggers ekiden's disk-resize dance, which we don't need for MVP.
